{% doc %}
  @prompt
    espacement section 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-section-spacing-{{ ai_gen_id }} {
    display: block;
    box-sizing: border-box;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin-top: {{ block.settings.top_spacing }}px;
    margin-bottom: {{ block.settings.bottom_spacing }}px;
    padding-left: {{ block.settings.horizontal_padding }}px;
    padding-right: {{ block.settings.horizontal_padding }}px;
  }

  .ai-section-spacing-{{ ai_gen_id }}__inner {
    width: 100%;
    height: {{ block.settings.divider_height }}px;
    background: {{ block.settings.divider_color }};
    border-radius: {{ block.settings.corner_radius }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-section-spacing-{{ ai_gen_id }} {
      margin-top: {{ block.settings.mobile_top_spacing }}px;
      margin-bottom: {{ block.settings.mobile_bottom_spacing }}px;
      padding-left: 0;
      padding-right: 0;
    }
  }
{% endstyle %}

<div class="ai-section-spacing-{{ ai_gen_id }}" {{ block.shopify_attributes }} aria-hidden="true">
  {% if block.settings.show_divider %}
    <div class="ai-section-spacing-{{ ai_gen_id }}__inner"></div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Section spacing",
  "settings": [
    {
      "type": "header",
      "content": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "top_spacing",
      "label": "Space above",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "bottom_spacing",
      "label": "Space below",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "horizontal_padding",
      "label": "Side inset",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Mobile spacing"
    },
    {
      "type": "range",
      "id": "mobile_top_spacing",
      "label": "Space above",
      "min": 0,
      "max": 120,
      "step": 6,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "mobile_bottom_spacing",
      "label": "Space below",
      "min": 0,
      "max": 120,
      "step": 6,
      "unit": "px",
      "default": 30
    },
    {
      "type": "header",
      "content": "Optional divider"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show divider",
      "default": false
    },
    {
      "type": "range",
      "id": "divider_height",
      "label": "Divider thickness",
      "min": 1,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color",
      "default": "#D9DEE1"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Divider corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Section spacing"
    }
  ],
  "tag": null,
  "class": "section-spacing-block"
}
{% endschema %}