{% doc %}
  @prompt
    Section simple : un titre (police, taille, couleur modifiables) puis une vidéo carrée 1:1 aux bords arrondis juste en dessous. Réglages : espacement entre le titre et la vidéo, espacement haut et bas de la section.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% liquid
  assign title_font = block.settings.title_font
%}

{% style %}
  {{ title_font | font_face: font_display: 'swap' }}

  .ai-video-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding-top: {{ block.settings.spacing_top }}px;
    padding-bottom: {{ block.settings.spacing_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-video-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .ai-video-title-{{ ai_gen_id }} {
    font-family: {{ title_font.family }}, {{ title_font.fallback_families }};
    font-weight: {{ title_font.weight }};
    font-style: {{ title_font.style }};
    font-size: {{ block.settings.title_size }}px;
    line-height: 1.2;
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_video_spacing }}px 0;
  }

  .ai-video-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: min({{ block.settings.video_width }}px, 100%);
    aspect-ratio: 1 / 1;
    border-radius: {{ block.settings.video_radius }}px;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-video-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-video-placeholder-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-video-placeholder-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
    opacity: 0.4;
  }

  @media screen and (max-width: 749px) {
    .ai-video-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }
  }
{% endstyle %}

<div class="ai-video-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-video-container-{{ ai_gen_id }}">
    {% if block.settings.title != blank %}
      <h2 class="ai-video-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
    {% endif %}

    <div class="ai-video-wrapper-{{ ai_gen_id }}">
      {% if block.settings.video != blank %}
        <video
          class="ai-video-{{ ai_gen_id }}"
          playsinline
          preload="metadata"
          {% if block.settings.autoplay %}
            autoplay muted loop
          {% else %}
            controls
          {% endif %}
          {% if block.settings.video.preview_image %}
            poster="{{ block.settings.video.preview_image | image_url: width: 1000 }}"
          {% endif %}
        >
          {% for source in block.settings.video.sources %}
            <source src="{{ source.url }}" type="{{ source.mime_type }}">
          {% endfor %}
        </video>
      {% else %}
        <div class="ai-video-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Titre + vidéo",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Espacements"
    },
    {
      "type": "range",
      "id": "spacing_top",
      "label": "Espacement haut de la section",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "spacing_bottom",
      "label": "Espacement bas de la section",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "title_video_spacing",
      "label": "Espacement entre le titre et la vidéo",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Couleur de fond",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Titre"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Découvrez notre produit en vidéo"
    },
    {
      "type": "font_picker",
      "id": "title_font",
      "label": "Police d'écriture",
      "default": "poppins_n7"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Taille du titre",
      "min": 16,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Couleur du titre",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Vidéo"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Vidéo"
    },
    {
      "type": "range",
      "id": "video_width",
      "label": "Largeur maximale de la vidéo",
      "min": 200,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 500
    },
    {
      "type": "range",
      "id": "video_radius",
      "label": "Arrondi des bords",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Lecture automatique (muette, en boucle)",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Titre + vidéo"
    }
  ]
}
{% endschema %}
