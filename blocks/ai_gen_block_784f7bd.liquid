{% doc %}
  @prompt
    avis étoile 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-star-rating-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 100%;
    color: {{ block.settings.text_color }};
    font-family: inherit;
  }

  .ai-star-rating-{{ ai_gen_id }}__inner {
    display: flex;
    align-items: center;
    justify-content: {{ block.settings.alignment }};
    gap: 8px;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    line-height: 1.4;
  }

  .ai-star-rating-{{ ai_gen_id }}__stars {
    display: inline-flex;
    gap: 2px;
    color: {{ block.settings.star_color }};
    flex: 0 0 auto;
  }

  .ai-star-rating-{{ ai_gen_id }}__star {
    display: block;
    width: {{ block.settings.star_size }}px;
    height: {{ block.settings.star_size }}px;
  }

  .ai-star-rating-{{ ai_gen_id }}__star--empty {
    color: {{ block.settings.empty_star_color }};
  }

  .ai-star-rating-{{ ai_gen_id }}__value {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    font-weight: 600;
    white-space: nowrap;
  }

  .ai-star-rating-{{ ai_gen_id }}__count {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
  }
{% endstyle %}

<div class="ai-star-rating-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-star-rating-{{ ai_gen_id }}__inner" role="img" aria-label="Note : {{ block.settings.rating }} sur 5{% if block.settings.review_count > 0 %}, {{ block.settings.review_count }} avis{% endif %}">
    <span class="ai-star-rating-{{ ai_gen_id }}__stars" aria-hidden="true">
      {% for i in (1..5) %}
        {% if i <= block.settings.rating %}
          <svg class="ai-star-rating-{{ ai_gen_id }}__star" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" focusable="false"><path d="M12 2.4 14.95 8.38l6.6.96-4.78 4.66 1.13 6.58L12 17.47l-5.9 3.11 1.13-6.58-4.78-4.66 6.6-.96L12 2.4Z"/></svg>
        {% else %}
          <svg class="ai-star-rating-{{ ai_gen_id }}__star ai-star-rating-{{ ai_gen_id }}__star--empty" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" focusable="false"><path d="M12 2.4 14.95 8.38l6.6.96-4.78 4.66 1.13 6.58L12 17.47l-5.9 3.11 1.13-6.58-4.78-4.66 6.6-.96L12 2.4Z"/></svg>
        {% endif %}
      {% endfor %}
    </span>
    {% if block.settings.show_rating %}<span class="ai-star-rating-{{ ai_gen_id }}__value">{{ block.settings.rating }} / 5</span>{% endif %}
    {% if block.settings.show_count and block.settings.review_count > 0 %}<span class="ai-star-rating-{{ ai_gen_id }}__count">({{ block.settings.review_count }} avis)</span>{% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Avis étoilé",
  "settings": [
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Largeur sur ordinateur",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "rating",
      "label": "Note sur 5",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "review_count",
      "label": "Nombre d’avis",
      "min": 0,
      "max": 1000,
      "step": 10,
      "default": 100
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Afficher la note",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Afficher le nombre d’avis",
      "default": true
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignement",
      "options": [
        { "value": "flex-start", "label": "À gauche" },
        { "value": "center", "label": "Au centre" },
        { "value": "flex-end", "label": "À droite" }
      ],
      "default": "flex-start"
    },
    {
      "type": "range",
      "id": "star_size",
      "label": "Taille des étoiles",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Taille du texte",
      "min": 12,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Couleur des étoiles",
      "default": "#A66B00"
    },
    {
      "type": "color",
      "id": "empty_star_color",
      "label": "Étoiles non remplies",
      "default": "#767676"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Couleur du texte",
      "default": "#1A1A1A"
    }
  ],
  "presets": [
    {
      "name": "Avis étoilé"
    }
  ],
  "tag": null,
  "class": "star-rating-block"
}
{% endschema %}