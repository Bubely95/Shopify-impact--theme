{% doc %}
  @prompt
    avis avec des étole
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-review-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: 24px;
    box-sizing: border-box;
    color: #1a1a1a;
    background: #ffffff;
    border: 1px solid rgba(26, 26, 26, 0.14);
    border-radius: 12px;
    font-family: inherit;
  }
  .ai-review-{{ ai_gen_id }}__heading { margin: 0 0 12px; font-size: 1.25rem; line-height: 1.3; color: #1a1a1a; }
  .ai-review-{{ ai_gen_id }}__stars { color: #795500; letter-spacing: 2px; font-size: 1.1rem; }
  .ai-review-{{ ai_gen_id }}__meta { display: flex; align-items: center; flex-wrap: wrap; gap: 8px 12px; margin: 8px 0 14px; font-size: 0.875rem; }
  .ai-review-{{ ai_gen_id }}__author { font-weight: 600; }
  .ai-review-{{ ai_gen_id }}__verified { padding: 3px 8px; border-radius: 999px; background: #f3f5f6; font-size: 0.75rem; }
  .ai-review-{{ ai_gen_id }}__text { margin: 0; line-height: 1.6; }
{% endstyle %}

<div class="ai-review-{{ ai_gen_id }}" style="width: {{ block.settings.desktop_width_percent }}%;" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}<h2 class="ai-review-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
  <div class="ai-review-{{ ai_gen_id }}__stars" role="img" aria-label="{{ block.settings.rating }} sur 5">{% for i in (1..5) %}{% if i <= block.settings.rating %}★{% else %}☆{% endif %}{% endfor %}</div>
  <div class="ai-review-{{ ai_gen_id }}__meta">
    {% if block.settings.reviewer != blank %}<span class="ai-review-{{ ai_gen_id }}__author">{{ block.settings.reviewer | escape }}</span>{% endif %}
    {% if block.settings.show_verified %}<span class="ai-review-{{ ai_gen_id }}__verified">Achat vérifié</span>{% endif %}
  </div>
  {% if block.settings.review_text != blank %}<div class="ai-review-{{ ai_gen_id }}__text">{{ block.settings.review_text }}</div>{% endif %}
</div>

{% schema %}
{
  "name": "Avis client",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Un avis client" },
    { "type": "range", "id": "rating", "label": "Note", "min": 1, "max": 5, "step": 1, "default": 5 },
    { "type": "text", "id": "reviewer", "label": "Nom du client" },
    { "type": "checkbox", "id": "show_verified", "label": "Afficher achat vérifié", "default": false },
    { "type": "richtext", "id": "review_text", "label": "Avis", "default": "<p>Ajoutez ici un avis client authentique.</p>" },
    { "type": "range", "id": "desktop_width_percent", "label": "Largeur sur ordinateur", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 }
  ],
  "presets": [{ "name": "Avis client" }],
  "tag": null,
  "class": "customer-review-block"
}
{% endschema %}