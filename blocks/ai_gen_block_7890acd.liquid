{% doc %}
  @prompt
    crée moi une section témoignage, 5 étoile ou je peut changer la couleur espacement haut et bas et entre les étoiles, ensuite un titre un peu gras en police d'écriture Poppins, ensuite un sous titre petit, ensuite une galerie d'image defilente ( pas automatique) je peut changer la taille d'image et les image on des bordure de couleur, en bas de chaque image il y a l'avis client, met un paragraphe simple et juste en haut le nom prenom avec une sorte de "point" avec le texte Vérifié d'une autre couleur ( et le point) , et tout en bas ajoute une barre de progression des avis, il y a 3 avis en tout , centre tout les élementvers le milieu, , enleve en bas les élement, textes ect, je veut que les dernier element soit la barre de progression, et fait que la barre soit plus stylé et intéractf, sans les fleches, fait que les partie Nom prenom + Vérifié soit entouré d'une autre couleur avec fond , enleve ce qui entoure le nom prenom et le vérifié et fait qu'il y'ai en bas de chaque nom prenon un avis , enleve la barre de progression et fait quelle que chose de plus simple, enleve les 3 petit point, et fait que la barre de progressions soit simple en fine, pour les avis fait que le premiere avis soit celui de gauche et pas celui du milieu , ajoute un parametre d'espacement entre chaque élément, par exemple l'espacement en bas des avis vers la barre de progression, fait que le titre principal soit plus épais , met un paramettre , pour le titre, gras, semi gras ect , fait que le titre soit plus rapproché par ligne ajoute un parametre, met un parametre pour reduire l'espacement etre les avis et la barre de progression
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-testimonial-section-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding-top: {{ block.settings.spacing_top }}px;
    padding-bottom: {{ block.settings.spacing_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-testimonial-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .ai-testimonial-stars-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: {{ block.settings.star_spacing }}px;
    margin-bottom: {{ block.settings.stars_bottom_spacing }}px;
  }

  .ai-testimonial-star-{{ ai_gen_id }} {
    width: {{ block.settings.star_size }}px;
    height: {{ block.settings.star_size }}px;
    fill: {{ block.settings.star_color }};
  }

  .ai-testimonial-title-{{ ai_gen_id }} {
    font-family: 'Poppins', sans-serif;
    {% if block.settings.title_weight == 'normal' %}
      font-weight: 400;
    {% elsif block.settings.title_weight == 'medium' %}
      font-weight: 500;
    {% elsif block.settings.title_weight == 'semibold' %}
      font-weight: 600;
    {% elsif block.settings.title_weight == 'bold' %}
      font-weight: 700;
    {% elsif block.settings.title_weight == 'extrabold' %}
      font-weight: 800;
    {% endif %}
    font-size: {{ block.settings.title_size }}px;
    line-height: {{ block.settings.title_line_height }};
    text-align: center;
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_bottom_spacing }}px 0;
  }

  .ai-testimonial-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    text-align: center;
    color: {{ block.settings.subtitle_color }};
    margin: 0 0 {{ block.settings.subtitle_bottom_spacing }}px 0;
  }

  .ai-testimonial-gallery-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    margin-bottom: {{ block.settings.reviews_to_progress_spacing }}px;
  }

  .ai-testimonial-gallery-{{ ai_gen_id }} {
    display: flex;
    justify-content: flex-start;
    gap: {{ block.settings.image_gap }}px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding-bottom: 10px;
  }

  .ai-testimonial-gallery-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-testimonial-card-{{ ai_gen_id }} {
    flex: 0 0 auto;
    width: {{ block.settings.image_size }}px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .ai-testimonial-image-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.image_size }}px;
    height: {{ block.settings.image_size }}px;
    border: {{ block.settings.image_border_width }}px solid {{ block.settings.image_border_color }};
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
    margin-bottom: {{ block.settings.image_bottom_spacing }}px;
  }

  .ai-testimonial-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-testimonial-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-testimonial-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
  }

  .ai-testimonial-info-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: {{ block.settings.info_gap }}px;
    width: 100%;
  }

  .ai-testimonial-author-header-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .ai-testimonial-author-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.author_name_size }}px;
    font-weight: 600;
    color: {{ block.settings.author_name_color }};
    margin: 0;
  }

  .ai-testimonial-verified-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: {{ block.settings.verified_text_size }}px;
    color: {{ block.settings.verified_color }};
  }

  .ai-testimonial-verified-dot-{{ ai_gen_id }} {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: {{ block.settings.verified_color }};
  }

  .ai-testimonial-review-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.review_text_size }}px;
    color: {{ block.settings.review_text_color }};
    text-align: center;
    line-height: 1.5;
    margin: 0;
    max-width: {{ block.settings.image_size }}px;
  }

  .ai-testimonial-progress-{{ ai_gen_id }} {
    width: 100%;
    max-width: 600px;
  }

  .ai-testimonial-progress-bar-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.progress_bar_height }}px;
    background: {{ block.settings.progress_bar_background }};
    border-radius: {{ block.settings.progress_bar_radius }}px;
    overflow: hidden;
  }

  .ai-testimonial-progress-fill-{{ ai_gen_id }} {
    height: 100%;
    background: {{ block.settings.progress_bar_fill_color }};
    border-radius: {{ block.settings.progress_bar_radius }}px;
    transition: width 0.8s ease-out;
  }

  @media screen and (max-width: 749px) {
    .ai-testimonial-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }

    .ai-testimonial-card-{{ ai_gen_id }} {
      width: calc({{ block.settings.image_size }}px * 0.8);
    }

    .ai-testimonial-image-wrapper-{{ ai_gen_id }} {
      width: calc({{ block.settings.image_size }}px * 0.8);
      height: calc({{ block.settings.image_size }}px * 0.8);
    }

    .ai-testimonial-review-text-{{ ai_gen_id }} {
      max-width: calc({{ block.settings.image_size }}px * 0.8);
    }
  }
{% endstyle %}

<testimonial-section-{{ ai_gen_id }}
  class="ai-testimonial-section-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-testimonial-container-{{ ai_gen_id }}">
    <div class="ai-testimonial-stars-{{ ai_gen_id }}">
      {% for i in (1..5) %}
        <svg
          class="ai-testimonial-star-{{ ai_gen_id }}"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
        </svg>
      {% endfor %}
    </div>

    {% if block.settings.title != blank %}
      <h2 class="ai-testimonial-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
    {% endif %}

    {% if block.settings.subtitle != blank %}
      <p class="ai-testimonial-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
    {% endif %}

    <div class="ai-testimonial-gallery-wrapper-{{ ai_gen_id }}">
      <div class="ai-testimonial-gallery-{{ ai_gen_id }}" data-gallery>
        {% for i in (1..4) %}
          {% liquid
            assign image_key = 'review_' | append: i | append: '_image'
            assign name_key = 'review_' | append: i | append: '_name'
            assign review_key = 'review_' | append: i | append: '_text'

            assign review_image = block.settings[image_key]
            assign review_name = block.settings[name_key]
            assign review_text = block.settings[review_key]
          %}

          <div class="ai-testimonial-card-{{ ai_gen_id }}">
            <div class="ai-testimonial-image-wrapper-{{ ai_gen_id }}">
              {% if review_image %}
                <img
                  src="{{ review_image | image_url: width: 600 }}"
                  alt="{{ review_name | escape }}"
                  class="ai-testimonial-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              {% else %}
                <div class="ai-testimonial-image-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            <div class="ai-testimonial-info-{{ ai_gen_id }}">
              <div class="ai-testimonial-author-header-{{ ai_gen_id }}">
                {% if review_name != blank %}
                  <p class="ai-testimonial-author-name-{{ ai_gen_id }}">{{ review_name }}</p>
                {% endif %}
                <div class="ai-testimonial-verified-{{ ai_gen_id }}">
                  <span class="ai-testimonial-verified-dot-{{ ai_gen_id }}"></span>
                  <span>{{ block.settings.verified_text }}</span>
                </div>
              </div>

              {% if review_text != blank %}
                <p class="ai-testimonial-review-text-{{ ai_gen_id }}">{{ review_text }}</p>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>

    <div class="ai-testimonial-progress-{{ ai_gen_id }}">
      <div class="ai-testimonial-progress-bar-container-{{ ai_gen_id }}">
        <div
          class="ai-testimonial-progress-fill-{{ ai_gen_id }}"
          data-progress-fill
          style="width: 0%;"
          data-target="{{ block.settings.progress_percentage }}"
        ></div>
      </div>
    </div>
  </div>
</testimonial-section-{{ ai_gen_id }}>

<script>
  (function() {
    class TestimonialSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.gallery = this.querySelector('[data-gallery]');
        this.progressFill = this.querySelector('[data-progress-fill]');
        
        this.setupScrollBehavior();
        this.animateProgress();
      }

      setupScrollBehavior() {
        if (!this.gallery) return;

        let isDown = false;
        let startX;
        let scrollLeft;

        this.gallery.addEventListener('mousedown', (e) => {
          isDown = true;
          this.gallery.style.cursor = 'grabbing';
          startX = e.pageX - this.gallery.offsetLeft;
          scrollLeft = this.gallery.scrollLeft;
        });

        this.gallery.addEventListener('mouseleave', () => {
          isDown = false;
          this.gallery.style.cursor = 'grab';
        });

        this.gallery.addEventListener('mouseup', () => {
          isDown = false;
          this.gallery.style.cursor = 'grab';
        });

        this.gallery.addEventListener('mousemove', (e) => {
          if (!isDown) return;
          e.preventDefault();
          const x = e.pageX - this.gallery.offsetLeft;
          const walk = (x - startX) * 2;
          this.gallery.scrollLeft = scrollLeft - walk;
        });
      }

      animateProgress() {
        if (!this.progressFill) return;
        
        const targetWidth = this.progressFill.getAttribute('data-target');
        
        setTimeout(() => {
          this.progressFill.style.width = targetWidth + '%';
        }, 300);
      }
    }

    customElements.define('testimonial-section-{{ ai_gen_id }}', TestimonialSection{{ ai_gen_id }});
  })();
</script>

