{% doc %}
  @prompt
    Section témoignages clients : 5 étoiles (couleur, taille, espacement), titre avec police modifiable (font picker, poids, taille, interligne, espacement des lettres), sous-titre, galerie de VIDÉOS défilante (non automatique, glisser à la souris / au doigt, sans flèches), bordure colorée sur les vidéos, taille et format réglables, sous chaque vidéo : nom + point "Vérifié" coloré puis l'avis en paragraphe simple, tout centré, et en dernier élément une barre de progression fine, simple et interactive (cliquable / glissable). 4 emplacements d'avis (les vides sont masqués). Tous les espacements sont réglables.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% liquid
  assign title_font = block.settings.title_font | font_modify: 'weight', block.settings.title_weight
  assign is_autoplay = false
  if block.settings.video_mode == 'autoplay'
    assign is_autoplay = true
  endif
%}

{% style %}
  {{ title_font | font_face: font_display: 'swap' }}

  .ai-testimonial-section-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding-top: {{ block.settings.spacing_top }}px;
    padding-bottom: {{ block.settings.spacing_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-testimonial-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* Étoiles */
  .ai-testimonial-stars-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: {{ block.settings.star_spacing }}px;
    margin-bottom: {{ block.settings.stars_bottom_spacing }}px;
  }

  .ai-testimonial-star-{{ ai_gen_id }} {
    width: {{ block.settings.star_size }}px;
    height: {{ block.settings.star_size }}px;
    fill: {{ block.settings.star_color }};
  }

  /* Titre */
  .ai-testimonial-title-{{ ai_gen_id }} {
    font-family: {{ title_font.family }}, {{ title_font.fallback_families }};
    font-weight: {{ title_font.weight }};
    font-style: {{ title_font.style }};
    font-size: {{ block.settings.title_size }}px;
    line-height: {{ block.settings.title_line_height }};
    letter-spacing: {{ block.settings.title_letter_spacing }}px;
    color: {{ block.settings.title_color }};
    max-width: 900px;
    margin: 0 0 {{ block.settings.title_bottom_spacing }}px 0;
  }

  .ai-testimonial-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0 0 {{ block.settings.subtitle_bottom_spacing }}px 0;
  }

  /* Galerie */
  .ai-testimonial-gallery-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    margin-bottom: {{ block.settings.reviews_to_progress_spacing }}px;
  }

  .ai-testimonial-gallery-{{ ai_gen_id }} {
    display: flex;
    justify-content: {% if block.settings.gallery_align == 'center' %}safe center{% else %}flex-start{% endif %};
    gap: {{ block.settings.video_gap }}px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    cursor: grab;
    user-select: none;
  }

  .ai-testimonial-gallery-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-testimonial-gallery-{{ ai_gen_id }}.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
  }

  .ai-testimonial-card-{{ ai_gen_id }} {
    flex: 0 0 auto;
    width: min({{ block.settings.video_width }}px, 78vw);
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .ai-testimonial-video-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: {{ block.settings.video_ratio }};
    border: {{ block.settings.video_border_width }}px solid {{ block.settings.video_border_color }};
    border-radius: {{ block.settings.video_border_radius }}px;
    overflow: hidden;
    background-color: #f4f4f4;
    margin-bottom: {{ block.settings.video_bottom_spacing }}px;
    cursor: pointer;
  }

  .ai-testimonial-video-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-testimonial-placeholder-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-testimonial-placeholder-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
    opacity: 0.4;
  }

  /* Boutons lecture / son */
  .ai-testimonial-play-{{ ai_gen_id }},
  .ai-testimonial-sound-{{ ai_gen_id }} {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 0;
    padding: 0;
    border-radius: 50%;
    background: {{ block.settings.play_button_color }};
    color: {{ block.settings.play_icon_color }};
    cursor: pointer;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .ai-testimonial-play-{{ ai_gen_id }} {
    top: 50%;
    left: 50%;
    width: 56px;
    height: 56px;
    transform: translate(-50%, -50%);
  }

  .ai-testimonial-play-{{ ai_gen_id }} svg {
    width: 22px;
    height: 22px;
    margin-left: 3px;
    fill: currentColor;
  }

  .ai-testimonial-video-wrapper-{{ ai_gen_id }}:hover .ai-testimonial-play-{{ ai_gen_id }} {
    transform: translate(-50%, -50%) scale(1.08);
  }

  .ai-testimonial-video-wrapper-{{ ai_gen_id }}.is-playing .ai-testimonial-play-{{ ai_gen_id }} {
    opacity: 0;
    pointer-events: none;
  }

  .ai-testimonial-sound-{{ ai_gen_id }} {
    right: 10px;
    bottom: 10px;
    width: 34px;
    height: 34px;
  }

  .ai-testimonial-sound-{{ ai_gen_id }} svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ai-testimonial-sound-{{ ai_gen_id }} .icon-on { display: none; }
  .ai-testimonial-video-wrapper-{{ ai_gen_id }}.is-unmuted .icon-on { display: block; }
  .ai-testimonial-video-wrapper-{{ ai_gen_id }}.is-unmuted .icon-off { display: none; }

  /* Infos avis */
  .ai-testimonial-info-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: {{ block.settings.info_gap }}px;
    width: 100%;
  }

  .ai-testimonial-author-header-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 4px 8px;
  }

  .ai-testimonial-author-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.author_name_size }}px;
    font-weight: 600;
    color: {{ block.settings.author_name_color }};
    margin: 0;
  }

  .ai-testimonial-verified-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: {{ block.settings.verified_text_size }}px;
    color: {{ block.settings.verified_color }};
  }

  .ai-testimonial-verified-dot-{{ ai_gen_id }} {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: {{ block.settings.verified_color }};
  }

  .ai-testimonial-review-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.review_text_size }}px;
    color: {{ block.settings.review_text_color }};
    line-height: 1.5;
    margin: 0;
  }

  /* Barre de progression (interactive) */
  .ai-testimonial-progress-{{ ai_gen_id }} {
    width: 100%;
    max-width: {{ block.settings.progress_bar_width }}px;
    padding: 10px 0;
    cursor: pointer;
    touch-action: none;
  }

  .ai-testimonial-track-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.progress_bar_height }}px;
    background: {{ block.settings.progress_bar_background }};
    border-radius: 999px;
    overflow: hidden;
  }

  .ai-testimonial-thumb-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 100%;
    background: {{ block.settings.progress_bar_fill_color }};
    border-radius: 999px;
    will-change: transform, width;
  }

  .ai-testimonial-play-{{ ai_gen_id }}:focus-visible,
  .ai-testimonial-sound-{{ ai_gen_id }}:focus-visible {
    outline: 2px solid {{ block.settings.video_border_color }};
    outline-offset: 2px;
  }

  @media screen and (max-width: 749px) {
    .ai-testimonial-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }
  }
{% endstyle %}

<testimonial-section-{{ ai_gen_id }}
  class="ai-testimonial-section-{{ ai_gen_id }}"
  data-mode="{{ block.settings.video_mode }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-testimonial-container-{{ ai_gen_id }}">
    <div class="ai-testimonial-stars-{{ ai_gen_id }}" aria-hidden="true">
      {% for i in (1..5) %}
        <svg
          class="ai-testimonial-star-{{ ai_gen_id }}"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
        </svg>
      {% endfor %}
    </div>

    {% if block.settings.title != blank %}
      <h2 class="ai-testimonial-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
    {% endif %}

    {% if block.settings.subtitle != blank %}
      <p class="ai-testimonial-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
    {% endif %}

    <div class="ai-testimonial-gallery-wrapper-{{ ai_gen_id }}">
      <div class="ai-testimonial-gallery-{{ ai_gen_id }}" data-gallery>
        {% for i in (1..4) %}
          {% liquid
            assign video_key = 'review_' | append: i | append: '_video'
            assign name_key = 'review_' | append: i | append: '_name'
            assign review_key = 'review_' | append: i | append: '_text'

            assign review_video = block.settings[video_key]
            assign review_name = block.settings[name_key]
            assign review_text = block.settings[review_key]
          %}

          {% if review_video != blank or review_name != blank or review_text != blank %}
            <div class="ai-testimonial-card-{{ ai_gen_id }}">
              <div class="ai-testimonial-video-wrapper-{{ ai_gen_id }}" data-video-wrapper>
                {% if review_video != blank %}
                  <video
                    class="ai-testimonial-video-{{ ai_gen_id }}"
                    playsinline
                    preload="metadata"
                    draggable="false"
                    aria-label="{{ review_name | escape }}"
                    {% if review_video.preview_image %}
                      poster="{{ review_video.preview_image | image_url: width: 800 }}"
                    {% endif %}
                    {% if is_autoplay %}muted loop{% endif %}
                  >
                    {% for source in review_video.sources %}
                      <source src="{{ source.url }}" type="{{ source.mime_type }}">
                    {% endfor %}
                  </video>

                  {% if is_autoplay %}
                    <button
                      type="button"
                      class="ai-testimonial-sound-{{ ai_gen_id }}"
                      data-sound
                      aria-label="Activer / couper le son"
                    >
                      <svg viewBox="0 0 24 24" class="icon-off"><path d="M11 5L6 9H2v6h4l5 4V5z"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>
                      <svg viewBox="0 0 24 24" class="icon-on"><path d="M11 5L6 9H2v6h4l5 4V5z"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/></svg>
                    </button>
                  {% else %}
                    <button
                      type="button"
                      class="ai-testimonial-play-{{ ai_gen_id }}"
                      data-play
                      aria-label="Lire la vidéo"
                    >
                      <svg viewBox="0 0 24 24"><path d="M6 4l14 8-14 8V4z"/></svg>
                    </button>
                  {% endif %}
                {% else %}
                  <div class="ai-testimonial-placeholder-{{ ai_gen_id }}">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>

              <div class="ai-testimonial-info-{{ ai_gen_id }}">
                <div class="ai-testimonial-author-header-{{ ai_gen_id }}">
                  {% if review_name != blank %}
                    <p class="ai-testimonial-author-name-{{ ai_gen_id }}">{{ review_name }}</p>
                  {% endif %}
                  {% if block.settings.verified_text != blank %}
                    <span class="ai-testimonial-verified-{{ ai_gen_id }}">
                      <span class="ai-testimonial-verified-dot-{{ ai_gen_id }}"></span>
                      {{ block.settings.verified_text }}
                    </span>
                  {% endif %}
                </div>

                {% if review_text != blank %}
                  <p class="ai-testimonial-review-text-{{ ai_gen_id }}">{{ review_text }}</p>
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="ai-testimonial-progress-{{ ai_gen_id }}" data-progress role="scrollbar" aria-label="Progression des avis">
      <div class="ai-testimonial-track-{{ ai_gen_id }}" data-track>
        <div class="ai-testimonial-thumb-{{ ai_gen_id }}" data-thumb></div>
      </div>
    </div>
  </div>
</testimonial-section-{{ ai_gen_id }}>

<script>
  (function() {
    class TestimonialSection{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.ac = new AbortController();
        this.gallery = this.querySelector('[data-gallery]');
        this.progress = this.querySelector('[data-progress]');
        this.track = this.querySelector('[data-track]');
        this.thumb = this.querySelector('[data-thumb]');
        this.mode = this.dataset.mode;
        this.wrappers = Array.from(this.querySelectorAll('[data-video-wrapper]'));
        this.dragged = false;

        if (!this.gallery) return;
        this.setupDrag();
        this.setupProgress();
        this.setupVideos();
      }

      disconnectedCallback() {
        if (this.ac) this.ac.abort();
        if (this.io) this.io.disconnect();
        if (this.ro) this.ro.disconnect();
      }

      /* Glisser à la souris (le tactile utilise le défilement natif) */
      setupDrag() {
        const g = this.gallery;
        const signal = this.ac.signal;
        let down = false, startX = 0, startLeft = 0;

        g.addEventListener('pointerdown', (e) => {
          if (e.pointerType !== 'mouse' || e.button !== 0) return;
          down = true;
          this.dragged = false;
          startX = e.clientX;
          startLeft = g.scrollLeft;
        }, { signal });

        window.addEventListener('pointermove', (e) => {
          if (!down) return;
          const dx = e.clientX - startX;
          if (Math.abs(dx) > 5) {
            this.dragged = true;
            g.classList.add('is-dragging');
          }
          if (this.dragged) g.scrollLeft = startLeft - dx;
        }, { signal });

        window.addEventListener('pointerup', () => {
          if (!down) return;
          down = false;
          g.classList.remove('is-dragging');
          setTimeout(() => { this.dragged = false; }, 0);
        }, { signal });

        // Empêche le clic (lecture vidéo) après un glissement
        g.addEventListener('click', (e) => {
          if (this.dragged) {
            e.preventDefault();
            e.stopPropagation();
          }
        }, { capture: true, signal });
      }

      /* Barre de progression : suit le défilement, cliquable et glissable */
      setupProgress() {
        const g = this.gallery;
        const signal = this.ac.signal;
        if (!this.thumb || !this.track || !this.progress) return;

        const update = () => {
          const max = g.scrollWidth - g.clientWidth;
          const w = g.scrollWidth > 0 ? Math.min(1, g.clientWidth / g.scrollWidth) : 1;
          const p = max > 0 ? g.scrollLeft / max : 0;
          this.thumb.style.width = (w * 100) + '%';
          this.thumb.style.transform = 'translateX(' + (p * (1 / w - 1) * 100) + '%)';
        };

        const scrollToPointer = (clientX) => {
          const rect = this.track.getBoundingClientRect();
          const max = g.scrollWidth - g.clientWidth;
          if (max <= 0) return;
          const w = Math.min(1, g.clientWidth / g.scrollWidth);
          const thumbW = rect.width * w;
          const travel = rect.width - thumbW;
          if (travel <= 0) return;
          const p = Math.min(1, Math.max(0, (clientX - rect.left - thumbW / 2) / travel));
          g.scrollLeft = p * max;
        };

        let active = false;
        this.progress.addEventListener('pointerdown', (e) => {
          active = true;
          this.progress.setPointerCapture(e.pointerId);
          scrollToPointer(e.clientX);
        }, { signal });
        this.progress.addEventListener('pointermove', (e) => {
          if (active) scrollToPointer(e.clientX);
        }, { signal });
        const stop = () => { active = false; };
        this.progress.addEventListener('pointerup', stop, { signal });
        this.progress.addEventListener('pointercancel', stop, { signal });

        g.addEventListener('scroll', update, { passive: true, signal });
        if ('ResizeObserver' in window) {
          this.ro = new ResizeObserver(update);
          this.ro.observe(g);
        } else {
          window.addEventListener('resize', update, { signal });
        }
        update();
      }

      /* Vidéos : lecture au clic, ou autoplay muet avec bouton son */
      setupVideos() {
        const signal = this.ac.signal;
        const items = this.wrappers
          .map((wrap) => ({ wrap, video: wrap.querySelector('video') }))
          .filter((item) => item.video);

        if (this.mode === 'autoplay') {
          this.io = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              const v = entry.target;
              if (entry.isIntersecting) {
                const p = v.play();
                if (p && p.catch) p.catch(() => {});
              } else {
                v.pause();
              }
            });
          }, { threshold: 0.6 });

          items.forEach(({ wrap, video }) => {
            this.io.observe(video);
            const toggleSound = () => {
              const unmute = video.muted;
              items.forEach((o) => {
                o.video.muted = true;
                o.wrap.classList.remove('is-unmuted');
              });
              if (unmute) {
                video.muted = false;
                wrap.classList.add('is-unmuted');
              }
            };
            wrap.addEventListener('click', toggleSound, { signal });
          });
        } else {
          items.forEach(({ wrap, video }) => {
            wrap.addEventListener('click', () => {
              if (video.paused) {
                items.forEach((o) => { if (o.video !== video) o.video.pause(); });
                const p = video.play();
                if (p && p.catch) p.catch(() => {});
              } else {
                video.pause();
              }
            }, { signal });
            video.addEventListener('play', () => wrap.classList.add('is-playing'), { signal });
            video.addEventListener('pause', () => wrap.classList.remove('is-playing'), { signal });
            video.addEventListener('ended', () => wrap.classList.remove('is-playing'), { signal });
          });
        }
      }
    }

    customElements.define('testimonial-section-{{ ai_gen_id }}', TestimonialSection{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Témoignages vidéo",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Espacements généraux"
    },
    {
      "type": "range",
      "id": "spacing_top",
      "label": "Espacement haut",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "spacing_bottom",
      "label": "Espacement bas",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Largeur sur ordinateur",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Couleur de fond",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Étoiles"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Couleur",
      "default": "#ffc300"
    },
    {
      "type": "range",
      "id": "star_size",
      "label": "Taille des étoiles",
      "min": 10,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "star_spacing",
      "label": "Espacement entre les étoiles",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "stars_bottom_spacing",
      "label": "Espacement sous les étoiles",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Titre"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Nos clients adorent nos produits"
    },
    {
      "type": "font_picker",
      "id": "title_font",
      "label": "Police d'écriture",
      "default": "poppins_n7"
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Épaisseur",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Moyen" },
        { "value": "600", "label": "Semi-gras" },
        { "value": "700", "label": "Gras" },
        { "value": "800", "label": "Extra-gras" },
        { "value": "900", "label": "Noir (très épais)" }
      ],
      "default": "700"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Taille",
      "min": 16,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "title_line_height",
      "label": "Espacement entre les lignes",
      "min": 0.8,
      "max": 2,
      "step": 0.1,
      "default": 1.1
    },
    {
      "type": "range",
      "id": "title_letter_spacing",
      "label": "Espacement des lettres",
      "min": -2,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
