{% doc %}
  @prompt
    section, texte defilant, chaque petit message est séparé d'un point, on peut changer la taille du texte, lapolice, les couleur de fond, les espacement en haut et en bas la taille du fond, la vitesse de defilemment 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-marquee-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    padding-block: {{ block.settings.vertical_padding }}px;
  }

  .ai-marquee-{{ ai_gen_id }}__viewport {
    display: flex;
    overflow: hidden;
    width: 100%;
  }

  .ai-marquee-{{ ai_gen_id }}__track {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    width: max-content;
    animation: ai-marquee-scroll-{{ ai_gen_id }} {{ block.settings.speed }}s linear infinite;
    will-change: transform;
  }

  .ai-marquee-{{ ai_gen_id }}:hover .ai-marquee-{{ ai_gen_id }}__track {
    animation-play-state: paused;
  }

  .ai-marquee-{{ ai_gen_id }}__group {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: {{ block.settings.message_spacing }}px;
    padding-inline-end: {{ block.settings.message_spacing }}px;
  }

  .ai-marquee-{{ ai_gen_id }}__message {
    flex: 0 0 auto;
    margin: 0;
    color: inherit;
    font-family: {{ block.settings.text_font.family }}, {{ block.settings.text_font.fallback_families }};
    font-size: {{ block.settings.text_size }}px;
    font-weight: {{ block.settings.text_font.weight }};
    line-height: 1.3;
    white-space: nowrap;
  }

  .ai-marquee-{{ ai_gen_id }}__dot {
    display: inline-block;
    flex: 0 0 auto;
    width: 0.32em;
    height: 0.32em;
    border-radius: 50%;
    background: currentColor;
  }

  @keyframes ai-marquee-scroll-{{ ai_gen_id }} {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-marquee-{{ ai_gen_id }}__viewport { overflow-x: auto; }
    .ai-marquee-{{ ai_gen_id }}__track { animation: none; }
    .ai-marquee-{{ ai_gen_id }}__group[aria-hidden="true"] { display: none; }
  }
{% endstyle %}

<div class="ai-marquee-{{ ai_gen_id }}" style="width: {{ block.settings.desktop_width_percent }}%;" {{ block.shopify_attributes }}>
  {% if block.settings.messages != blank %}
    {% assign message_items = block.settings.messages | newline_to_br | split: '<br />' %}
    <div class="ai-marquee-{{ ai_gen_id }}__viewport" role="region" aria-label="{{ block.settings.accessibility_label | escape }}">
      <div class="ai-marquee-{{ ai_gen_id }}__track">
        {% for copy in (1..2) %}
          <div class="ai-marquee-{{ ai_gen_id }}__group" {% if copy == 2 %}aria-hidden="true"{% endif %}>
            {% for message in message_items %}
              {% assign clean_message = message | strip %}
              {% if clean_message != blank %}
                {% unless forloop.first %}<span class="ai-marquee-{{ ai_gen_id }}__dot" aria-hidden="true"></span>{% endunless %}
                <p class="ai-marquee-{{ ai_gen_id }}__message">{{ clean_message | escape }}</p>
              {% endif %}
            {% endfor %}
          </div>
        {% endfor %}
      </div>
    </div>
  {% else %}
    <div class="ai-marquee-{{ ai_gen_id }}__viewport" {{ block.shopify_attributes }}>
      <p class="ai-marquee-{{ ai_gen_id }}__message">Ajoutez vos messages séparés par un retour à la ligne</p>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Texte défilant",
  "settings": [
    {
      "type": "textarea",
      "id": "messages",
      "label": "Messages",
      "default": "Livraison offerte dès 80 €\nConfectionné avec soin\nRetours sous 14 jours"
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Libellé accessible",
      "default": "Informations de la boutique"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Largeur sur ordinateur",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "font_picker",
      "id": "text_font",
      "label": "Police",
      "default": "helvetica_n4"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Taille du texte",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Fond",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texte",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "vertical_padding",
      "label": "Espacement vertical",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "message_spacing",
      "label": "Espace entre les messages",
      "min": 12,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Durée du défilement",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "s",
      "default": 30
    }
  ],
  "presets": [
    {
      "name": "Texte défilant"
    }
  ],
  "tag": null,
  "class": "marquee-block"
}
{% endschema %}