        "collapsible_text_yVJRad": {
          "type": "collapsible_text",
          "settings": {
            "title": "Caractéristiques",
            "content": "<ul><li><strong>Dimensions :</strong> 30 × 20 cm | 20 x 20cm</li><li><strong>Éclairage LED :</strong> un rendu lumineux et éclatant pour chaque dessin</li><li><strong>Alimentation :</strong> câble USB inclus</li><li><strong>7 marqueurs fluorescents</strong> réutilisables fournis</li><li><strong>Surface effaçable à l'infini,</strong> avec chiffon doux inclus</li><li><strong>Matériaux durables :</strong> acrylique et plastique ABS</li><li><strong>Âge recommandé :</strong> de 3 à 14 ans</li><li><strong>Faible consommation :</strong> compatible avec les chargeurs USB standard</li><li><strong>Résistant aux éclaboussures (IP44) :</strong> ne pas immerger</li></ul>"
          }
        },
        "collapsible_text_Aygc4n": {
          "type": "collapsible_text",
          "settings": {
            "title": "Mode d'emploi et utilisation",
            "content": "<p><strong>1. Branchez la tablette</strong><br/>Connectez simplement la tablette pour activer l’éclairage.</p><p><strong>2. L’enfant dessine ou écrit</strong><br/>Utilisez les stylos magiques pour dessiner, écrire ou faire des exercices.</p><p><strong>3. Effet lumineux magique</strong><br/>Les tracés s’illuminent instantanément pour rendre l’activité plus ludique.</p><p><strong>4. Effacez facilement</strong><br/>Un simple geste suffit pour effacer et recommencer.</p><p><strong>5. Réutilisable à l’infini</strong><br/>La tablette peut être utilisée encore et encore, sans limite.</p>"
          }
        },
        "collapsible_text_hEnf9a": {
          "type": "collapsible_text",
          "settings": {
            "title": "Contenu du colis",
            "content": "<p>Chaque commande inclut :</p><p>• 1x&nbsp;<strong>Tablette LED magique™</strong><br/><br/>• 7x&nbsp;<strong>Stylos lumineux multicolores</strong><br/><br/>• 1x&nbsp;<strong>Câble USB de recharge</strong><br/><br/>• 1x&nbsp;<strong>Guide d’utilisation</strong></p>"
          }
        },
