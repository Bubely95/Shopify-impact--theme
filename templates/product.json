        "collapsible_text_hAUi3Y": {
          "type": "collapsible_text",
          "settings": {
            "title": "Garantie et retours",
            "content": "<p><strong>Essai sans risque de 30 jours</strong> : Essayez-les pendant <strong>30 jours</strong> ; si vous n’êtes pas satisfait, vous serez <strong>intégralement remboursé</strong>.<br/></p><p><strong>Assistance humaine et personnalisée</strong> : Une question ? Notre équipe est là pour vous <strong>accompagner à chaque étape</strong>.</p>"
