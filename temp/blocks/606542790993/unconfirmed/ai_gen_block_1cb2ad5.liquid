{% doc %}
  @prompt
    fait moi une section simple, vidéo format 1:1 et jusre en haut un titre, on peut changer la taille du texte et ca police, l'espacement entre le texte et la vidéo et l'espacement générale de la section haut et bas 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  {{ block.settings.heading_font | font_face: font_display: 'swap' }}
  .ai-video-title-{{ ai_gen_id }} { display: block; width: 100%; padding-top: {{ block.settings.space_top }}px; padding-bottom: {{ block.settings.space_bottom }}px; }
  .ai-video-title-{{ ai_gen_id }}__inner { width: {{ block.settings.desktop_width_percent }}%; max-width: 100%; margin: 0 auto; }
  .ai-video-title-{{ ai_gen_id }}__heading { margin: 0 0 {{ block.settings.title_video_space }}px; color: {{ block.settings.text_color }}; font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }}; font-size: {{ block.settings.heading_size }}px; font-weight: {{ block.settings.heading_font.weight }}; line-height: 1.2; text-align: {{ block.settings.alignment }}; }
  .ai-video-title-{{ ai_gen_id }}__media { width: 100%; aspect-ratio: 1 / 1; overflow: hidden; background: #f3f5f6; }
  .ai-video-title-{{ ai_gen_id }}__media video, .ai-video-title-{{ ai_gen_id }}__media iframe { display: block; width: 100%; height: 100%; object-fit: cover; border: 0; }
  .ai-video-title-{{ ai_gen_id }}__placeholder { display: flex; position: relative; width: 100%; height: 100%; align-items: center; justify-content: center; color: #41494e; text-align: center; font-size: 14px; }
  .ai-video-title-{{ ai_gen_id }}__placeholder svg { display: block; width: 100%; height: 100%; position: absolute; inset: 0; color: #d9dfe2; }
  .ai-video-title-{{ ai_gen_id }}__empty-text { position: relative; z-index: 1; padding: 8px 12px; background: #ffffff; }
  @media screen and (max-width: 749px) {
    .ai-video-title-{{ ai_gen_id }}__inner { width: 100%; }
    .ai-video-title-{{ ai_gen_id }}__heading { font-size: {{ block.settings.heading_size | times: 0.8 }}px; }
  }
{% endstyle %}

<div class="ai-video-title-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-video-title-{{ ai_gen_id }}__inner">
    {% if block.settings.title != blank %}<h2 class="ai-video-title-{{ ai_gen_id }}__heading">{{ block.settings.title | escape }}</h2>{% endif %}
    <div class="ai-video-title-{{ ai_gen_id }}__media">
      {% if block.settings.video != blank %}
        {{ block.settings.video | video_tag: autoplay: false, loop: block.settings.loop_video, controls: true, muted: false, image_size: '1200x' }}
      {% elsif block.settings.video_url != blank %}
        {% if block.settings.video_url.type == 'youtube' %}
          <iframe src="https://www.youtube.com/embed/{{ block.settings.video_url.id }}" title="{{ block.settings.title | default: 'Vidéo' | escape }}" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen loading="lazy"></iframe>
        {% elsif block.settings.video_url.type == 'vimeo' %}
          <iframe src="https://player.vimeo.com/video/{{ block.settings.video_url.id }}" title="{{ block.settings.title | default: 'Vidéo' | escape }}" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen loading="lazy"></iframe>
        {% endif %}
      {% else %}
        <div class="ai-video-title-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}<span class="ai-video-title-{{ ai_gen_id }}__empty-text">Ajoutez une vidéo dans les réglages du bloc</span></div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Titre et vidéo carrée",
  "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "Découvrez notre vidéo" },
    { "type": "video", "id": "video", "label": "Vidéo Shopify" },
    { "type": "video_url", "id": "video_url", "label": "Vidéo YouTube ou Vimeo", "accept": ["youtube", "vimeo"] },
    { "type": "checkbox", "id": "loop_video", "label": "Lire en boucle", "default": false },
    { "type": "font_picker", "id": "heading_font", "label": "Police du titre", "default": "helvetica_n4" },
    { "type": "range", "id": "heading_size", "label": "Taille du texte", "min": 16, "max": 60, "step": 2, "unit": "px", "default": 32 },
    { "type": "color", "id": "text_color", "label": "Couleur du texte", "default": "#1A1A1A" },
    { "type": "select", "id": "alignment", "label": "Alignement du titre", "options": [{ "value": "left", "label": "Gauche" }, { "value": "center", "label": "Centré" }, { "value": "right", "label": "Droite" }], "default": "center" },
    { "type": "range", "id": "title_video_space", "label": "Espacement titre-vidéo", "min": 0, "max": 60, "step": 4, "unit": "px", "default": 16 },
    { "type": "range", "id": "space_top", "label": "Espacement en haut", "min": 0, "max": 100, "step": 5, "unit": "px", "default": 30 },
    { "type": "range", "id": "space_bottom", "label": "Espacement en bas", "min": 0, "max": 100, "step": 5, "unit": "px", "default": 30 },
    { "type": "range", "id": "desktop_width_percent", "label": "Largeur sur ordinateur", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 }
  ],
  "presets": [{ "name": "Titre et vidéo carrée" }],
  "tag": null,
  "class": "video-title-block"
}
{% endschema %}