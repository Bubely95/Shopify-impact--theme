{%- comment -%}
  Section : Avis vidéo (trust) - défilement horizontal avec vidéos qui se chevauchent
{%- endcomment -%}

{{ section.settings.heading_font | font_face: font_display: 'swap' }}
{{ section.settings.body_font | font_face: font_display: 'swap' }}

<style>
  #avis-videos-{{ section.id }} {
    --av-bg: {{ section.settings.bg_color }};
    --av-heading: {{ section.settings.heading_color }};
    --av-text: {{ section.settings.text_color }};
    --av-accent: {{ section.settings.accent_color }};
    --av-accent-2: {{ section.settings.accent_color_2 }};
    --av-card-bg: {{ section.settings.card_bg }};
    --av-name: {{ section.settings.name_color }};
    --av-stars: {{ section.settings.stars_color }};
    --av-card-w: {{ section.settings.card_width }}px;
    --av-card-w-m: {{ section.settings.card_width_mobile }}px;
    --av-overlap: {{ section.settings.overlap }}px;
    --av-overlap-m: {{ section.settings.overlap_mobile }}px;
    --av-radius: {{ section.settings.radius }}px;
    --av-ratio: {{ section.settings.ratio }};
    --av-tilt: {{ section.settings.tilt }}deg;
    --av-offset: {{ section.settings.offset }}px;
    --av-text-gap: {{ section.settings.text_gap }}px;
    --av-head-gap: {{ section.settings.heading_gap }}px;
    --av-pad-top: {{ section.settings.padding_top }}px;
    --av-pad-bottom: {{ section.settings.padding_bottom }}px;
    --av-side: {{ section.settings.side_padding }}px;
    --av-font-h: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    --av-font-b: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
    --av-size-h: {{ section.settings.heading_size }}px;
    --av-size-h-m: {{ section.settings.heading_size_mobile }}px;
    --av-size-b: {{ section.settings.body_size }}px;

    background: var(--av-bg);
    padding: var(--av-pad-top) 0 var(--av-pad-bottom);
    font-family: var(--av-font-b);
    color: var(--av-text);
    overflow: hidden;
    position: relative;
  }

  #avis-videos-{{ section.id }} * { box-sizing: border-box; }

  /* ---------- En-tête ---------- */
  #avis-videos-{{ section.id }} .av-head {
    max-width: 760px;
    margin: 0 auto var(--av-head-gap);
    padding: 0 20px;
    text-align: center;
  }

  #avis-videos-{{ section.id }} .av-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--av-accent);
    color: #000000;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.4px;
    padding: 6px 14px;
    border-radius: 999px;
    margin-bottom: 14px;
  }

  #avis-videos-{{ section.id }} .av-title {
    font-family: var(--av-font-h);
    font-size: var(--av-size-h-m);
    line-height: 1.15;
    color: var(--av-heading);
    margin: 0 0 12px;
    font-weight: 700;
  }

  #avis-videos-{{ section.id }} .av-title span { color: var(--av-accent-2); }

  #avis-videos-{{ section.id }} .av-sub {
    font-size: var(--av-size-b);
    line-height: 1.6;
    margin: 0;
    opacity: 0.85;
  }

  /* ---------- Piste de défilement ---------- */
  #avis-videos-{{ section.id }} .av-wrap { position: relative; }

  #avis-videos-{{ section.id }} .av-track {
    display: flex;
    align-items: flex-start;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x proximity;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: 30px var(--av-side) 40px;
  }
  #avis-videos-{{ section.id }} .av-track::-webkit-scrollbar { display: none; }

  /* ---------- Carte ---------- */
  #avis-videos-{{ section.id }} .av-card {
    position: relative;
    flex: 0 0 var(--av-card-w-m);
    width: var(--av-card-w-m);
    scroll-snap-align: center;
    transition: transform 0.35s ease;
    z-index: 1;
  }

  #avis-videos-{{ section.id }} .av-card + .av-card { margin-left: calc(var(--av-overlap-m) * -1); }

  #avis-videos-{{ section.id }} .av-card:nth-child(odd) .av-video-box { transform: rotate(calc(var(--av-tilt) * -1)); }
  #avis-videos-{{ section.id }} .av-card:nth-child(even) { margin-top: var(--av-offset); }
  #avis-videos-{{ section.id }} .av-card:nth-child(even) .av-video-box { transform: rotate(var(--av-tilt)); }

  #avis-videos-{{ section.id }} .av-card:hover,
  #avis-videos-{{ section.id }} .av-card:focus-within { z-index: 20; }

  #avis-videos-{{ section.id }} .av-card:hover .av-video-box,
  #avis-videos-{{ section.id }} .av-card:focus-within .av-video-box {
    transform: rotate(0deg) scale(1.03);
    box-shadow: 0 22px 44px rgba(0, 0, 0, 0.28);
  }

  /* ---------- Vidéo ---------- */
  #avis-videos-{{ section.id }} .av-video-box {
    position: relative;
    width: 100%;
    aspect-ratio: var(--av-ratio);
    border-radius: var(--av-radius);
    overflow: hidden;
    background: #111111;
    border: 4px solid #FFFFFF;
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.22);
    transition: transform 0.35s ease, box-shadow 0.35s ease;
  }

  #avis-videos-{{ section.id }} .av-video-box video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #avis-videos-{{ section.id }} .av-empty {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFFFFF;
    font-size: 13px;
    text-align: center;
    padding: 16px;
    background: linear-gradient(135deg, var(--av-accent-2), #0D7BCB);
  }

  #avis-videos-{{ section.id }} .av-sound {
    position: absolute;
    right: 10px;
    bottom: 10px;
    width: 38px;
    height: 38px;
    border: 0;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
    padding: 0;
  }
  #avis-videos-{{ section.id }} .av-sound:hover { background: var(--av-accent-2); transform: scale(1.08); }
  #avis-videos-{{ section.id }} .av-sound svg { width: 18px; height: 18px; }
  #avis-videos-{{ section.id }} .av-sound .icon-on { display: none; }
  #avis-videos-{{ section.id }} .av-sound.is-on .icon-on { display: block; }
  #avis-videos-{{ section.id }} .av-sound.is-on .icon-off { display: none; }

  /* ---------- Avis ---------- */
  #avis-videos-{{ section.id }} .av-review {
    position: relative;
    margin-top: 14px;
    width: calc(100% - var(--av-overlap-m) - var(--av-text-gap));
    min-width: 170px;
    background: var(--av-card-bg);
    border-radius: calc(var(--av-radius) * 0.7);
    padding: 14px 16px 16px;
    border-top: 3px solid var(--av-accent);
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.1);
  }

  #avis-videos-{{ section.id }} .av-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 6px 10px;
    margin-bottom: 8px;
  }

  #avis-videos-{{ section.id }} .av-name {
    font-family: var(--av-font-h);
    font-size: calc(var(--av-size-b) + 1px);
    font-weight: 700;
    color: var(--av-name);
    margin: 0;
    line-height: 1.2;
  }

  #avis-videos-{{ section.id }} .av-stars {
    display: flex;
    gap: 2px;
    color: var(--av-stars);
  }
  #avis-videos-{{ section.id }} .av-stars svg { width: 15px; height: 15px; fill: currentColor; }
  #avis-videos-{{ section.id }} .av-stars svg.is-empty { opacity: 0.25; }

  #avis-videos-{{ section.id }} .av-verified {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 11px;
    font-weight: 600;
    color: var(--av-accent-2);
    margin-bottom: 8px;
  }
  #avis-videos-{{ section.id }} .av-verified svg { width: 13px; height: 13px; }

  #avis-videos-{{ section.id }} .av-quote {
    font-size: var(--av-size-b);
    line-height: 1.6;
    color: var(--av-text);
    margin: 0;
  }

  /* ---------- Flèches ---------- */
  #avis-videos-{{ section.id }} .av-arrows {
    display: none;
    justify-content: center;
    gap: 12px;
    margin-top: 6px;
  }

  #avis-videos-{{ section.id }} .av-arrow {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 2px solid var(--av-accent-2);
    background: transparent;
    color: var(--av-accent-2);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
    padding: 0;
  }
  #avis-videos-{{ section.id }} .av-arrow:hover { background: var(--av-accent-2); color: #FFFFFF; transform: scale(1.06); }
  #avis-videos-{{ section.id }} .av-arrow svg { width: 20px; height: 20px; }

  /* ---------- Ordinateur ---------- */
  @media (min-width: 750px) {
    #avis-videos-{{ section.id }} .av-title { font-size: var(--av-size-h); }
    #avis-videos-{{ section.id }} .av-card { flex-basis: var(--av-card-w); width: var(--av-card-w); }
    #avis-videos-{{ section.id }} .av-card + .av-card { margin-left: calc(var(--av-overlap) * -1); }
    #avis-videos-{{ section.id }} .av-review { width: calc(100% - var(--av-overlap) - var(--av-text-gap)); }
    {%- if section.settings.show_arrows %}
    #avis-videos-{{ section.id }} .av-arrows { display: flex; }
    {%- endif %}
  }
</style>

<section id="avis-videos-{{ section.id }}" data-section-id="{{ section.id }}">
  {%- if section.settings.badge != blank or section.settings.heading != blank or section.settings.subheading != blank -%}
    <div class="av-head">
      {%- if section.settings.badge != blank -%}
        <div class="av-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" fill="#000000"/></svg>
          {{ section.settings.badge }}
        </div>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="av-title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="av-sub">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="av-wrap">
    <div class="av-track" data-av-track>
      {%- for block in section.blocks -%}
        <article class="av-card" {{ block.shopify_attributes }}>
          <div class="av-video-box">
            {%- if block.settings.video != blank -%}
              <video
                muted loop playsinline preload="metadata"
                {% if block.settings.poster != blank %}poster="{{ block.settings.poster | image_url: width: 700 }}"{% elsif block.settings.video.preview_image %}poster="{{ block.settings.video.preview_image | image_url: width: 700 }}"{% endif %}>
                {%- for source in block.settings.video.sources -%}
                  <source src="{{ source.url }}" type="{{ source.mime_type }}">
                {%- endfor -%}
              </video>
            {%- elsif block.settings.video_url != blank -%}
              <video
                muted loop playsinline preload="metadata"
                {% if block.settings.poster != blank %}poster="{{ block.settings.poster | image_url: width: 700 }}"{% endif %}>
                <source src="{{ block.settings.video_url }}" type="video/mp4">
              </video>
            {%- else -%}
              <div class="av-empty">Ajoute une vidéo dans ce bloc</div>
            {%- endif -%}

            {%- if block.settings.video != blank or block.settings.video_url != blank -%}
              <button class="av-sound" type="button" aria-label="Activer ou couper le son" data-av-sound>
                <svg class="icon-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5L6 9H2v6h4l5 4V5z"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>
                <svg class="icon-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5L6 9H2v6h4l5 4V5z"/><path d="M15.54 8.46a5 5 0 010 7.07"/><path d="M19.07 4.93a10 10 0 010 14.14"/></svg>
              </button>
            {%- endif -%}
          </div>

          <div class="av-review">
            <div class="av-meta">
              <p class="av-name">{{ block.settings.name }}</p>
              <div class="av-stars" aria-label="Note : {{ block.settings.rating }} sur 5">
                {%- for i in (1..5) -%}
                  <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" {% if i > block.settings.rating %}class="is-empty"{% endif %}><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                {%- endfor -%}
              </div>
            </div>
            {%- if section.settings.show_verified -%}
              <div class="av-verified">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {{ section.settings.verified_label }}
              </div>
            {%- endif -%}
            <p class="av-quote">{{ block.settings.testimonial }}</p>
          </div>
        </article>
      {%- endfor -%}
    </div>

    <div class="av-arrows">
      <button class="av-arrow" type="button" aria-label="Précédent" data-av-prev>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <button class="av-arrow" type="button" aria-label="Suivant" data-av-next>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
    </div>
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('avis-videos-{{ section.id }}');
    if (!root) return;

    var track = root.querySelector('[data-av-track]');
    var videos = root.querySelectorAll('video');
    var prev = root.querySelector('[data-av-prev]');
    var next = root.querySelector('[data-av-next]');

    /* Lecture automatique quand la vidéo est visible */
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          var v = entry.target;
          if (entry.isIntersecting) {
            var p = v.play();
            if (p && p.catch) p.catch(function () {});
          } else {
            v.pause();
          }
        });
      }, { threshold: 0.4 });
      videos.forEach(function (v) { io.observe(v); });
    } else {
      videos.forEach(function (v) { v.play(); });
    }

    /* Bouton son */
    root.querySelectorAll('[data-av-sound]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var video = btn.parentElement.querySelector('video');
        if (!video) return;
        var willUnmute = video.muted;
        videos.forEach(function (v) { v.muted = true; });
        root.querySelectorAll('[data-av-sound]').forEach(function (b) { b.classList.remove('is-on'); });
        if (willUnmute) {
          video.muted = false;
          btn.classList.add('is-on');
        }
      });
    });

    /* Flèches */
    function step() {
      var card = track.querySelector('.av-card');
      if (!card) return 300;
      var style = window.getComputedStyle(track.querySelectorAll('.av-card')[1] || card);
      var overlap = Math.abs(parseFloat(style.marginLeft)) || 0;
      return card.offsetWidth - overlap;
    }
    if (prev) prev.addEventListener('click', function () { track.scrollBy({ left: -step(), behavior: 'smooth' }); });
    if (next) next.addEventListener('click', function () { track.scrollBy({ left: step(), behavior: 'smooth' }); });
  })();
</script>

{% schema %}
{
  "name": "Avis vidéo (trust)",
  "tag": "div",
  "class": "section-avis-videos",
  "settings": [
    { "type": "header", "content": "Textes" },
    { "type": "text", "id": "badge", "label": "Badge", "default": "Avis vérifiés" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Ils en parlent mieux que nous" },
    { "type": "textarea", "id": "subheading", "label": "Sous-titre", "default": "Découvre les retours de familles qui ont déjà adopté le produit." },
    { "type": "checkbox", "id": "show_verified", "label": "Afficher « Acheteur vérifié »", "default": true },
    { "type": "text", "id": "verified_label", "label": "Texte du label vérifié", "default": "Acheteur vérifié" },

    { "type": "header", "content": "Polices" },
    { "type": "font_picker", "id": "heading_font", "label": "Police des titres et des noms", "default": "poppins_n7" },
    { "type": "font_picker", "id": "body_font", "label": "Police des textes", "default": "poppins_n4" },
    { "type": "range", "id": "heading_size", "label": "Taille du titre (ordinateur)", "min": 20, "max": 60, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "heading_size_mobile", "label": "Taille du titre (mobile)", "min": 18, "max": 40, "step": 1, "unit": "px", "default": 26 },
    { "type": "range", "id": "body_size", "label": "Taille du texte des avis", "min": 12, "max": 20, "step": 1, "unit": "px", "default": 14 },

    { "type": "header", "content": "Couleurs" },
    { "type": "color", "id": "bg_color", "label": "Fond de la section", "default": "#F4F9FF" },
    { "type": "color", "id": "heading_color", "label": "Couleur du titre", "default": "#0B1F33" },
    { "type": "color", "id": "text_color", "label": "Couleur du texte", "default": "#3A4A5A" },
    { "type": "color", "id": "accent_color", "label": "Couleur d'accent (badge, filet)", "default": "#FBB713" },
    { "type": "color", "id": "accent_color_2", "label": "Couleur secondaire (boutons, détails)", "default": "#1092F0" },
    { "type": "color", "id": "card_bg", "label": "Fond des avis", "default": "#FFFFFF" },
    { "type": "color", "id": "name_color", "label": "Couleur du nom", "default": "#0B1F33" },
    { "type": "color", "id": "stars_color", "label": "Couleur des étoiles", "default": "#FBB713" },

    { "type": "header", "content": "Vidéos et chevauchement" },
    { "type": "range", "id": "card_width", "label": "Largeur d'une carte (ordinateur)", "min": 200, "max": 420, "step": 10, "unit": "px", "default": 290 },
    { "type": "range", "id": "card_width_mobile", "label": "Largeur d'une carte (mobile)", "min": 180, "max": 320, "step": 10, "unit": "px", "default": 230 },
    { "type": "range", "id": "overlap", "label": "Chevauchement (ordinateur)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "overlap_mobile", "label": "Chevauchement (mobile)", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 28 },
    { "type": "range", "id": "tilt", "label": "Inclinaison des vidéos", "min": 0, "max": 6, "step": 0.5, "unit": "°", "default": 2 },
    { "type": "range", "id": "offset", "label": "Décalage vertical d'une carte sur deux", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "radius", "label": "Arrondi des coins", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 22 },
    {
      "type": "select",
      "id": "ratio",
      "label": "Format des vidéos",
      "options": [
        { "value": "9 / 16", "label": "Vertical 9:16" },
        { "value": "3 / 4", "label": "Portrait 3:4" },
        { "value": "4 / 5", "label": "Portrait 4:5" },
        { "value": "1 / 1", "label": "Carré 1:1" }
      ],
      "default": "9 / 16"
    },
    { "type": "checkbox", "id": "show_arrows", "label": "Afficher les flèches (ordinateur)", "default": true },

    { "type": "header", "content": "Espacements" },
    { "type": "range", "id": "padding_top", "label": "Espace en haut", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Espace en bas", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "heading_gap", "label": "Espace entre l'en-tête et les vidéos", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 16 },
    { "type": "range", "id": "side_padding", "label": "Marge latérale de la piste", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "text_gap", "label": "Espace entre deux avis", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 12 }
  ],
  "blocks": [
    {
      "type": "avis",
      "name": "Avis vidéo",
      "limit": 12,
      "settings": [
        { "type": "video", "id": "video", "label": "Vidéo (hébergée sur Shopify)" },
        { "type": "text", "id": "video_url", "label": "Ou lien direct .mp4", "info": "Utilisé seulement si aucune vidéo n'est choisie au-dessus." },
        { "type": "image_picker", "id": "poster", "label": "Image d'aperçu (facultatif)" },
