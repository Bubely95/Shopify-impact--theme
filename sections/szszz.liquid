{% doc %}
  @prompt
    Section témoignages : 5 étoiles, titre (police et épaisseur au choix), sous-titre, galerie de vidéos défilante (non automatique) avec bordure de couleur, avis client sous chaque vidéo, barre de progression fine et interactive. Tout est centré, le premier avis est à gauche quand ça défile.
{% enddoc %}

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign title_font = block.settings.title_font | font_modify: 'weight', block.settings.title_weight %}
{% assign body_font = block.settings.body_font %}

{% style %}
  {{ title_font | font_face: font_display: 'swap' }}
  {{ body_font | font_face: font_display: 'swap' }}

  .tv-{{ ai_gen_id }} {
    --tv-video-w: {{ block.settings.video_width }}px;
    --tv-video-w-m: {{ block.settings.video_width_mobile }}px;
    --tv-gap: {{ block.settings.card_gap }}px;
    --tv-border-w: {{ block.settings.video_border_width }}px;
    --tv-border-c: {{ block.settings.video_border_color }};
    --tv-radius: {{ block.settings.video_radius }}px;
    --tv-ratio: {{ block.settings.video_ratio }};
    --tv-accent: {{ block.settings.accent_color }};

    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding-top: {{ block.settings.spacing_top }}px;
    padding-bottom: {{ block.settings.spacing_bottom }}px;
    background-color: {{ block.settings.background_color }};
    font-family: {{ body_font.family }}, {{ body_font.fallback_families }};
    box-sizing: border-box;
  }

  .tv-{{ ai_gen_id }} *,
  .tv-{{ ai_gen_id }} *::before,
  .tv-{{ ai_gen_id }} *::after { box-sizing: border-box; }

  .tv-{{ ai_gen_id }} .tv-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* ---------- Étoiles ---------- */
  .tv-{{ ai_gen_id }} .tv-stars {
    display: flex;
    justify-content: center;
    gap: {{ block.settings.star_spacing }}px;
    margin-bottom: {{ block.settings.stars_bottom_spacing }}px;
  }

  .tv-{{ ai_gen_id }} .tv-star {
    width: {{ block.settings.star_size }}px;
    height: {{ block.settings.star_size }}px;
    fill: {{ block.settings.star_color }};
  }

  /* ---------- Titre et sous-titre ---------- */
  .tv-{{ ai_gen_id }} .tv-title {
    font-family: {{ title_font.family }}, {{ title_font.fallback_families }};
    font-weight: {{ title_font.weight }};
    font-style: {{ title_font.style }};
    font-size: {{ block.settings.title_size }}px;
    line-height: {{ block.settings.title_line_height }};
    text-align: center;
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_bottom_spacing }}px;
  }

  .tv-{{ ai_gen_id }} .tv-subtitle {
    font-size: {{ block.settings.subtitle_size }}px;
    line-height: 1.5;
    text-align: center;
    color: {{ block.settings.subtitle_color }};
    margin: 0 0 {{ block.settings.subtitle_bottom_spacing }}px;
  }

  /* ---------- Galerie ---------- */
  .tv-{{ ai_gen_id }} .tv-gallery-wrap {
    width: 100%;
    margin-bottom: {{ block.settings.reviews_to_progress_spacing }}px;
  }

  .tv-{{ ai_gen_id }} .tv-gallery {
    display: flex;
    gap: var(--tv-gap);
    overflow-x: auto;
    overflow-y: hidden;
    padding: 6px 4px 12px;
    scroll-snap-type: x proximity;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    cursor: grab;
    outline: none;
  }
  .tv-{{ ai_gen_id }} .tv-gallery::-webkit-scrollbar { display: none; }
  .tv-{{ ai_gen_id }} .tv-gallery.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
    scroll-behavior: auto;
    user-select: none;
  }

  /* Centré s'il y a la place, aligné à gauche (premier avis) quand ça défile */
  .tv-{{ ai_gen_id }} .tv-card:first-child { margin-left: auto; }
  .tv-{{ ai_gen_id }} .tv-card:last-child { margin-right: auto; }

  .tv-{{ ai_gen_id }} .tv-card {
    flex: 0 0 auto;
    width: var(--tv-video-w-m);
    display: flex;
    flex-direction: column;
    align-items: center;
    scroll-snap-align: start;
  }

  /* ---------- Vidéo ---------- */
  .tv-{{ ai_gen_id }} .tv-video-box {
    position: relative;
    width: 100%;
    aspect-ratio: var(--tv-ratio);
    border: var(--tv-border-w) solid var(--tv-border-c);
    border-radius: var(--tv-radius);
    overflow: hidden;
    background: #111111;
    margin-bottom: {{ block.settings.video_bottom_spacing }}px;
    box-shadow: 0 10px 26px rgba(0, 0, 0, 0.12);
  }

  .tv-{{ ai_gen_id }} .tv-video-box video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .tv-{{ ai_gen_id }} .tv-empty {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 16px;
    font-size: 13px;
    color: #FFFFFF;
    background: linear-gradient(135deg, var(--tv-accent), #0D7BCB);
  }

  .tv-{{ ai_gen_id }} .tv-sound {
    position: absolute;
    right: 10px;
    bottom: 10px;
    width: 38px;
    height: 38px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.6);
    color: #FFFFFF;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .tv-{{ ai_gen_id }} .tv-sound:hover { background: var(--tv-accent); transform: scale(1.08); }
  .tv-{{ ai_gen_id }} .tv-sound svg { width: 18px; height: 18px; }
  .tv-{{ ai_gen_id }} .tv-sound .icon-on { display: none; }
  .tv-{{ ai_gen_id }} .tv-sound.is-on .icon-on { display: block; }
  .tv-{{ ai_gen_id }} .tv-sound.is-on .icon-off { display: none; }

  /* ---------- Avis ---------- */
  .tv-{{ ai_gen_id }} .tv-info {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: {{ block.settings.info_gap }}px;
    width: 100%;
  }

  .tv-{{ ai_gen_id }} .tv-author {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 4px 10px;
  }

  .tv-{{ ai_gen_id }} .tv-name {
    margin: 0;
    font-size: {{ block.settings.author_name_size }}px;
    font-weight: 600;
    color: {{ block.settings.author_name_color }};
  }

  .tv-{{ ai_gen_id }} .tv-verified {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: {{ block.settings.verified_text_size }}px;
    font-weight: 500;
    color: {{ block.settings.verified_color }};
  }

  .tv-{{ ai_gen_id }} .tv-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: {{ block.settings.verified_color }};
  }

  .tv-{{ ai_gen_id }} .tv-review {
    margin: 0;
    max-width: 100%;
    font-size: {{ block.settings.review_text_size }}px;
    line-height: 1.55;
    text-align: center;
    color: {{ block.settings.review_text_color }};
  }

  /* ---------- Barre de progression ---------- */
  .tv-{{ ai_gen_id }} .tv-progress {
    width: 100%;
    max-width: {{ block.settings.progress_width }}px;
    padding: 10px 0;
    cursor: pointer;
    touch-action: none;
  }

  .tv-{{ ai_gen_id }} .tv-bar {
    position: relative;
    width: 100%;
    height: {{ block.settings.progress_bar_height }}px;
    background: {{ block.settings.progress_bar_background }};
    border-radius: 999px;
    overflow: hidden;
    transition: transform 0.2s ease;
  }
  .tv-{{ ai_gen_id }} .tv-progress:hover .tv-bar { transform: scaleY(1.7); }

  .tv-{{ ai_gen_id }} .tv-fill {
    height: 100%;
    width: 0%;
    background: {{ block.settings.progress_bar_fill_color }};
    border-radius: 999px;
    transition: width 0.15s linear;
  }

  /* ---------- Ordinateur ---------- */
  @media screen and (min-width: 750px) {
    .tv-{{ ai_gen_id }} .tv-card { width: var(--tv-video-w); }
  }

  /* ---------- Mobile ---------- */
  @media screen and (max-width: 749px) {
    .tv-{{ ai_gen_id }} .tv-title { font-size: calc({{ block.settings.title_size }}px * 0.8); }
    .tv-{{ ai_gen_id }} .tv-gallery { padding-left: 20px; padding-right: 20px; }
  }
{% endstyle %}

<testimonial-videos class="tv-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="tv-container">